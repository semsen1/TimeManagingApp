<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1200"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder
        android:propertyName="rotation"
        android:valueType="floatType">
        <keyframe android:fraction="0.0" android:value="0" />
        <keyframe android:fraction="0.1" android:value="12" />
        <keyframe android:fraction="0.2" android:value="-12" />
        <keyframe android:fraction="0.3" android:value="10" />
        <keyframe android:fraction="0.4" android:value="-10" />
        <keyframe android:fraction="0.5" android:value="6" />
        <keyframe android:fraction="0.6" android:value="-6" />
        <keyframe android:fraction="0.7" android:value="0" />
        <keyframe android:fraction="1.0" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>